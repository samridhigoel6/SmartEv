# Blank uses the existing local persistent MongoDB replica set (.data/mongodb).
# Atlas or an external MongoDB deployment MUST support transactions.
MONGODB_URI=
MONGODB_DB=smart_ev_charging
PORT=4000
HOST=127.0.0.1
VITE_CURRENCY=INR
# First setup on Atlas/external MongoDB: set a unique administrator email and strong password.
# Local development without these values generates private credentials in .data/admin-login.txt.
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NAME=Workspace admin
# Set production only behind HTTPS; production session cookies require Secure transport.
NODE_ENV=development
